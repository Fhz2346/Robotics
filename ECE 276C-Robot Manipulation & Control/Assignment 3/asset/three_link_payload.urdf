<robot name="three_link_robot_with_payload">
	<material name="black">
		<color rgba="0 0 0 0.7" />
	</material>
	<material name="white">
		<color rgba="1 1 1 0.7" />
	</material>
	<material name="payload_yellow">
		<color rgba="1 0.65 0 1" />
	</material>

	<link name="base" />
	<link name="arm1">
		<inertial>
			<origin xyz="0 0 0.1" rpy="0 0 0" />
			<mass value="0.0754" />
			<inertia ixx="0.000259" iyy="0.000259" izz="0.00001508" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0 0 0.1" rpy="0 0 0" />
			<geometry><cylinder radius="0.02" length="0.2" /></geometry>
			<material name="black" />
		</visual>
	</link>

	<joint name="baseHinge" type="revolute">
		<parent link="base" />
		<child link="arm1" />
		<axis xyz="0 0 1" />
		<limit lower="-1000" upper="1000" effort="2000" velocity="1000" />
		<dynamics damping="0" friction="0" />
	</joint>

	<link name="arm2">
		<inertial>
			<origin xyz="0.1 0 0" rpy="0 -1.57 0" />
			<mass value="0.0754" />
			<inertia ixx="0.000259" iyy="0.000259" izz="0.00001508" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.1 0 0" rpy="0 -1.57 0" />
			<geometry><cylinder radius="0.02" length="0.2" /></geometry>
			<material name="white" />
		</visual>
	</link>

	<joint name="interArm" type="revolute">
		<parent link="arm1" />
		<child link="arm2" />
		<origin xyz="0 0 0.2" rpy="1.57 0 0" />
		<axis xyz="0 0 1" />
		<limit lower="-1000" upper="1000" effort="2000" velocity="1000" />
		<dynamics damping="0" friction="0" />
	</joint>

	<link name="arm3">
		<inertial>
			<origin xyz="0.1 0 0" rpy="0 1.57 0" />
			<mass value="0.0754" />
			<inertia ixx="0.000259" iyy="0.000259" izz="0.00001508" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.1 0 0" rpy="0 1.57 0" />
			<geometry><cylinder radius="0.02" length="0.2" /></geometry>
			<material name="white" />
		</visual>
	</link>

	<joint name="interArm2" type="revolute">
		<parent link="arm2" />
		<child link="arm3" />
		<origin xyz="0.2 0 0" rpy="0 0 0" />
		<axis xyz="0 0 1" />
		<limit lower="-1000" upper="1000" effort="2000" velocity="1000" />
		<dynamics damping="0" friction="0" />
	</joint>

	<!-- 3 kg point-mass payload located at the arm3 distal tip. -->
	<link name="payload">
		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<mass value="3.0" />
			<!-- Tiny positive inertia regularizes the ideal point mass-->
			<inertia ixx="1e-9" iyy="1e-9" izz="1e-9" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><sphere radius="0.025" /></geometry>
			<material name="payload_yellow" />
		</visual>
	</link>

	<joint name="tipPayloadFixed" type="fixed">
		<parent link="arm3" />
		<child link="payload" />
		<origin xyz="0.2 0 0" rpy="0 0 0" />
	</joint>
</robot>
